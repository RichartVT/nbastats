# Copiar a .env y ajustar.

# Postgres del docker-compose (puerto 5433 para no chocar con el brew local)
DATABASE_URL=postgresql+psycopg://nbastats:nbastats@localhost:5433/nbastats

# Temporadas a cargar. Las 5 completas más recientes.
SEASONS=2021-22,2022-23,2023-24,2024-25,2025-26

# Ingesta contra stats.nba.com (fuente unica del proyecto).
# IMPORTANTE: correr siempre desde la Mac. stats.nba.com descarta
# conexiones desde IPs de datacenter (AWS/GCP/Azure).
NBA_API_DELAY_SECONDS=0.7
NBA_API_TIMEOUT_SECONDS=30
NBA_API_MAX_RETRIES=5

# Ventana de re-ingesta para capturar correcciones oficiales de box scores.
BACKFILL_WINDOW_DAYS=7
