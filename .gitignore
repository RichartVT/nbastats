# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Entorno — cualquier variante, salvo el ejemplo que necesita el README
.env
.env.*
!.env.example

# Datos — nunca versionar el dataset ni los volcados
data/raw/
data/processed/
*.duckdb
*.sqlite
*.parquet
*.csv

# Volcados de la base. Ojo: *.sql NO se ignora, que db/sql/derive.sql
# y views.sql son código del proyecto.
*.dump
*.sql.gz
*.backup

# Node / frontend
node_modules/
web/dist/
web/.vite/

# macOS
.DS_Store

# Editores
.vscode/
.idea/

# Configuración de mis herramientas locales, no del proyecto
.claude/

# Registros de las descargas largas (ingest-pbp y compañía).
*.log
